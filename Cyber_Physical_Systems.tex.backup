	  \epsfig{file=figures/Fig_3_1_CPS.png,width=0.8\textwidth}\\
	  \caption {Architecture of a Cyber-Physical System}
     \end{center}
\end{figure}

\os{\newpage}    

\bi
     \ite Study of the behaviour of Cyber-Physical Systems
     \bi
	  \ite Simulationtools
	  \ite use of linear and nonlinear equations systems
	  \ite modeling time continuing and time discret systems
	  \ite models with concentrated parameters
	  \ite blockoriented systems
	  \ite objectorieted systems
     \ei
\ei

\bi
     \ite typical tools for the simulations
     \bi
	  \ite MatLab (Simulink)
	  \ite Mathematica
	  \ite Modelica (Dymola)
	  \ite OpenModelica
     \ei	  
\ei

\bi
     \ite standard methods in technical applications \pr blockoriented modells (systems)
     \ite fixed input/output relations (causal dependency, assignments)
     \ite often with the use of graphical input/output support
\ei

\begin{figure}[!hbtp]
