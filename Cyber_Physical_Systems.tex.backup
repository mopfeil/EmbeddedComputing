\end{figure}
\os{\newpage}
 
\bi
	\ite in physical systems objectorieted methods are more useful
	\ite focus on physical behavior (equations)
	\ite input/output relations more in the background (assigments not fixed)
\ei
\begin{figure}[!hbtp]%
