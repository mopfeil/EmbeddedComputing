\end{description}

%==============================================================================
\section{OpenModelica}
%==============================================================================
\begin{description}
\item Features of OpenModelica
\bi
	\ite objectoriented modeling and simulation
	\ite integration of hardware components in the simulation (HIL, \underline{H}ardware \underline{i}n the \underline{l}oop)
	\ite standardisation of interfaces for simulation (FMI, \underline{F}unctional \underline{m}ookup \underline{i}nterface)
	\ite description of a physikal system by a set of equations
	\ite no specific description of of input/output relations (equation systems has no assignments)
	\ite focus on physical dimension system (SI dimensions)
\ei

\item Features as an objectoriented modelling and simulation tool
\bi
	\ite data structure with objects (dada objects) and methods (functions) 
	\ite features and methods are linked to objects
	\ite features of objects are grouped in classes
	\ite classes can be parts of other classes (hierachical dada structures, modells)
	\ite group of classes in packages
	\ite separation between declaration and quantity (e.g. declaration of a resistor and specification of values)
	\ite inhertance of classes and subclasses
\ei
\item Features as a multi-domain modelling an simulation tool
\bi
	\ite declarative language (equation set, acausal modelling, high level specification)
	\ite combine modelling of electrical, mechanical, thermodynamic, hydraulic biological .. systems)
	\ite visual component modelling and simulation
     	\ite code generation opportunity (control application)

\ei

\end{description}

\begin{description}
     \item [{\rot\bf First Elements of OpenModelica}]~\\[-3ex]
\bi
     \ite Data types
     \bi
	  \ite Boolean: true, false
	  \ite Integer: 32-bit Integer-number (same as in C)
	  \ite Real: 64-bit floating point number (same as double in C)
	  \ite String: char-string
	  \ite enumeration: (same as in C)
     \ei
     \bigskip
     \bi
	  \ite acausal equation (no assigments, but description of relation between the Potential and the Flow)
	  \ite parameter
	  \ite example: simple differential equation \begin{math}\dot{x} = -a \cdot x\end{math}
     \ei	  
\ei     
\begin{lstlisting}
     class HDE
	  Real x(start = 1);
	  parameter Real a = 1;
     equation
	  der(x) = - a*x;
     end HDE;
\end{lstlisting}

\os{\newpage}
\begin{figure}[!hbtp]
     \begin{center}
	  \epsfig{file=figures/Fig_3_4_HDE_OMEdit,width=0.8\textwidth}\\
	  \caption {Modell HDE in OMEdit}
     \end{center}
\end{figure}
\os{\newpage}
\begin{figure}[!hbtp]
     \begin{center}
	  \epsfig{file=figures/Fig_3_5_HDE_Plot,width=0.8\textwidth}\\
	  \caption {Plot of the Modell HDE}
     \end{center}
\end{figure}
\os{\newpage}

\bi
     \ite number equations which describes of relation between the Potential and the Flow indicates the number of variables (state variables)
     \ite additionally a modell can contain algebraic equation (no derivatives)
     \ite example: Planar Pendulum 
\ei
\begin{figure}[!hbtp]
     \begin{center}
	  \epsfig{file=figures/Fig_3_6_Pendulum,width=0.3\textwidth}\\
	  \caption {Planar Pendulum}
     \end{center}
\end{figure}
\os{\newpage}

\begin{center}
     \begin{eqnarray*}  
	  m\dot{v}_x = -\frac{x}{L}F
     \end{eqnarray*}\
     \begin{eqnarray*}  
	  m\dot{v}_y = -\frac{y}{L} - mg
     \end{eqnarray*}\
     \begin{eqnarray*}  
	  \dot{x} = v_x
     \end{eqnarray*}\
     \begin{eqnarray*}  
	  \dot{y} = v_x
     \end{eqnarray*}\
      \begin{eqnarray*}  
	  x^2 + y^2 = L^2
     \end{eqnarray*}\
\end{center}
\os{\newpage}

\begin{lstlisting}
     class Pendulum
	  constant Real PI;
	  parameter Real m = 1, g = 9,81, L = 0.5;
	  Real F;
	  output Real x(start = 0.5), y(start = 0);
	  output Real vx, vy;
     equation
	  m*der(vx)=-(x/L)*F;
	  m*der(vy)=-(y/L)*F - m*g;
	  der(x)=vy;
	  der(y)=vy;
	  x^2 + y^2 = L^2;	/* algebraic equation */
     end Pendulum;
\end{lstlisting}

\os{\newpage}
\begin{figure}[!hbtp]
     \begin{center}
	  \epsfig{file=figures/Fig_3_7_Pendulum_Plot,width=0.8\textwidth}\\
	  \caption {Horizontal and Vertical Position of a Planar Pendulum}
     \end{center}
\end{figure}
\os{\newpage}

\end{description}
 
\begin{description}
\item[{\rot\bf Classes and Instances of OpenModelica }]~\\[-3ex]
\bi
	\ite Classes
	\bi 
		\ite every object has a class that defines the data and its behavior
		\ite a class has to kind of members:
	        \bi
		    \ite data variables (constants, parameter, result of computations)
		    \ite equations specifing the behaviour of the data (sometimes interact with other other equations, program execution)
		    \ite classes can be members of other classes
		\ei
		\ite example of a class
				
	\ei
\ei
\begin{lstlisting}
     class Point	/* Point in a three-dimensional space	*/
	 Real x;
	 Real y;
	 Real z;
     end Point;;
\end{lstlisting}     

\bi
     \ite Instances
     \bi
	  \ite instances are generated by the use of classes
	  \ite excample of instances of the class point (and define a new class triangle)
     \ei
\ei

\begin{lstlisting}
     class Triangle
	 Point point1;
	 Point point;
	 Point point;
     end Triangle;;
\end{lstlisting}  

\bi
     \ite with the instantiation an initializatiion can take place 
\ei
\begin{lstlisting}
     class Triangle
	  Point point1(start={1,2,3}];
	  Point point;
	  Point point;
     end Triangle;;
\end{lstlisting}  

