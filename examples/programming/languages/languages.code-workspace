{
  // The language experiments on the Raspberry Pi Pico in the Wokwi simulator.
  // Open with: code languages.code-workspace  (or File > Open Workspace from File)
  // Each folder: build (Terminal > Run Build Task, or the PlatformIO check mark),
  // then F1 -> "Wokwi: Start Simulator" while a file of that folder is open.
  // Who needs what (details, expected output and typical errors: README.md
  // in each folder):
  //   1p  C + inline asm   PlatformIO, environment pico2 (Pico 2, RP2350)
  //   2p  C                PlatformIO, environment pico  (Pico, RP2040)
  //   2p  Rust             cargo, no PlatformIO           (Pico, RP2040)
  //   3p  MicroPython      .venv + make_uf2.py, no PlatformIO (Pico, RP2040)
  //   3p  C reference      PlatformIO, environment pico  (Pico, RP2040, 125 MHz)
  // The PC versions (folders 1-inline-asm, 2-rust-memory, 3-python) are opened
  // as plain folders: File > Open Folder; see README.md.
  "folders": [
    { "name": "1p · inline asm · C, PlatformIO pico2 (Pico 2)", "path": "1-inline-asm/pico" },
    { "name": "2p · memory safety · C, PlatformIO pico", "path": "2-rust-memory/pico/c" },
    { "name": "2p · memory safety · Rust, cargo", "path": "2-rust-memory/pico/rust" },
    { "name": "3p · MicroPython · make_uf2.py", "path": "3-python/pico" },
    { "name": "3p · C reference · PlatformIO pico", "path": "3-python/pico/c_reference" }
  ],
  "settings": {
    "files.exclude": { "**/target": true, "**/.pio": true, "**/c_reference": true, "**/__pycache__": true },
    "rust-analyzer.cargo.allTargets": true,
    "python.defaultInterpreterPath": "${workspaceFolder:3p · MicroPython · make_uf2.py}/../.venv/bin/python"
  },
  "extensions": {
    "recommendations": [
      "wokwi.wokwi-vscode",
      "platformio.platformio-ide",
      "rust-lang.rust-analyzer",
      "ms-python.python"
    ]
  }
}
