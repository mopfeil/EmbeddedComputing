{
  // The language experiments on the Raspberry Pi Pico in the Wokwi simulator.
  // Open with: code languages.code-workspace  (or File > Open Workspace from File)
  // Each folder: build (Terminal > Run Build Task, or the PlatformIO check mark),
  // then F1 -> "Wokwi: Start Simulator" while a file of that folder is open.
  // The PC versions (folders 1-inline-asm, 2-rust-memory, 3-python) are opened
  // as plain folders: File > Open Folder; see README.md.
  "folders": [
    { "name": "1p · inline assembly on the Pico 2", "path": "1-inline-asm/pico" },
    { "name": "2p · memory safety: C on the Pico", "path": "2-rust-memory/pico/c" },
    { "name": "2p · memory safety: Rust on the Pico", "path": "2-rust-memory/pico/rust" },
    { "name": "3p · MicroPython on the Pico", "path": "3-python/pico" },
    { "name": "3p · C reference on the Pico", "path": "3-python/pico/c_reference" }
  ],
  "settings": {
    "files.exclude": { "**/target": true, "**/.pio": true, "**/c_reference": true, "**/__pycache__": true },
    "rust-analyzer.cargo.allTargets": true,
    "python.defaultInterpreterPath": "${workspaceFolder:3p · MicroPython on the Pico}/../.venv/bin/python"
  },
  "extensions": {
    "recommendations": [
      "wokwi.wokwi-vscode",
      "platformio.platformio-ide",
      "rust-lang.rust-analyzer",
      "ms-python.python"
    ]
  }
}
