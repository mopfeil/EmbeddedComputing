{
  // PlatformIO (VS Code extension "PlatformIO IDE", it puts `pio` on the PATH).
  // After the build: F1 -> "Wokwi: Start Simulator", output in the serial monitor.
  "version": "2.0.0",
  "tasks": [
    { "label": "1p: build for Pico 2", "type": "shell", "command": "pio run", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$gcc"] },
    { "label": "1p: show machine code of dot_c and dot_asm", "type": "shell", "command": "pio pkg exec -p toolchain-rp2040-earlephilhower -- arm-none-eabi-objdump -d --no-show-raw-insn .pio/build/pico2/firmware.elf | awk '/<_ZL5dot_c|<_ZL7dot_asm/,/^$/'", "problemMatcher": [] }
  ]
}
