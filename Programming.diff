< \end{center}
< \os{\newpage}
< \bi 
< 	\ite CCR \pr \underline{c}ondition \underline{c}ode \underline{r}egister 
< 	\ite 16 bit register (8 bit for supervisor and user operation, 8 only for supervisor operation)
< 
< 
